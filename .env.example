# ─────────────────────────────────────────────────────────────────────────────
# AdinKhepra / ASAF — Environment Variables
# Copy this file to .env.local for local dev. Never commit real secrets.
# Last synced: 2026-05-10 (matches Vercel + code audit)
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Auth + DB) ──────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
# NOTE: These are the public (anon) keys — safe to expose IF RLS policies are set.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Backend Agent URL ─────────────────────────────────────────────────────────
# The URL of your ASAF agent / VPS backend (e.g. https://agent.souhimbou.org)
# Used by: next.config.mjs (proxy rewrite), SCADA API routes
# MUST be set in Vercel → Environment Variables (Production + Preview)
AGENT_URL=https://agent.souhimbou.org

# Alias used by some frontend components — keep in sync with AGENT_URL
NEXT_PUBLIC_API_URL=https://agent.souhimbou.org

# Internal API URL used by server-side scan routes (docker network or VPS IP)
# Used by: src/app/api/scan/route.ts, src/app/api/scan/[id]/route.ts
ASAF_INTERNAL_API_URL=http://172.19.0.1:45444

# ── Stripe ────────────────────────────────────────────────────────────────────
# Server-side only — NEVER prefix with NEXT_PUBLIC_
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# The price ID for the subscription plan (starts with price_...)
# Create at: https://dashboard.stripe.com/products
STRIPE_PRICE_ID=price_...

# Webhook secret for verifying Stripe events (future use)
# Configure at: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Used by Supabase Edge Functions (send-welcome-email, send-password-reset-otp)
# Get from: https://resend.com/api-keys
# IMPORTANT: Also set this in Supabase: `supabase secrets set RESEND_API_KEY=re_...`
# Vercel does NOT inject vars into Supabase Edge Functions automatically.
RESEND_API_KEY=re_...

# ── App URL ───────────────────────────────────────────────────────────────────
# Your production domain — used for Stripe redirect URLs after checkout
# Must match your Vercel production domain
NEXT_PUBLIC_APP_URL=https://www.adinkhepra.com

# ── Application Metadata & Feature Flags ─────────────────────────────────────
# These are embedded in the client bundle (NEXT_PUBLIC_) — no secrets here
NEXT_PUBLIC_APP_NAME=AdinKhepra ASAF
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_TELEMETRY=true

# ── Testing / CI (Autonoma) ───────────────────────────────────────────────────
# Used by Autonoma UI testing harness — NOT injected into app bundle
# Set in Vercel → All Environments
AUTONOMA_CLIENT_ID=your-autonoma-client-id
AUTONOMA_SECRET_ID=your-autonoma-secret-id

# ── Scan Enrichment (server-side) ─────────────────────────────────────────────
SHODAN_API_KEY=
APIVOID_API_KEY=
STIGVIEWER_API_KEY=

# ── AI / LLM (server-side) ────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=

# ── Infrastructure (server-side) ──────────────────────────────────────────────
ELK_API_KEY=
ELK_URL=https://...

# ─────────────────────────────────────────────────────────────────────────────
# Vercel:   Add all vars in Project Settings → Environment Variables
# Supabase: Add edge function secrets with `supabase secrets set KEY=value`
# Fly.io:   Add server-side vars with `fly secrets set KEY=value`
# VPS:      Store in /opt/asaf/secrets/dashboard.env (not committed to git)
# ─────────────────────────────────────────────────────────────────────────────
