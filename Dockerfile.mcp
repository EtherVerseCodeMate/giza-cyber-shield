# syntax=docker/dockerfile:1
# KHEPRA MCP Server — Single-Command Production Image
#
# Targets:
#   AWS Marketplace GovCloud (ECR Public)
#   GHCR (open-core community)
#   Iron Bank (Dockerfile.ironbank for DoD)
#   MCP Registry / mcpservers.org / cline.bot (stdio transport)
#
# Single install:
#   docker run --rm -i ghcr.io/etherversecodemate/khepra-mcp:latest
#
# AWS Marketplace:
#   docker run --rm -i \
#     -e KHEPRA_LICENSE_KEY="$LICENSE" \
#     -e PHANTOM_SYMBOL=Eban \
#     -v /var/log/khepra:/var/log/khepra \
#     709825985650.dkr.ecr.us-gov-west-1.amazonaws.com/nouchix/khepra-mcp:latest

# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM golang:1.23-alpine AS builder

WORKDIR /src

# Build tools only — no network calls during build (vendored deps)
RUN apk add --no-cache git ca-certificates tzdata

ARG VERSION=1.0.0
ARG BUILD_DATE=unknown
ARG VCS_REF=unknown

COPY go.mod go.sum ./
COPY vendor/ ./vendor/
COPY pkg/ ./pkg/
COPY cmd/ ./cmd/

# Build the MCP server binary (primary entrypoint)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -mod=vendor \
    -trimpath \
    -ldflags="-s -w \
      -X main.Version=${VERSION} \
      -X main.BuildDate=${BUILD_DATE} \
      -X main.Commit=${VCS_REF}" \
    -o /out/khepra-mcp \
    ./cmd/khepra-mcp

# Build the Phantom sandbox runner (used by Docker-in-Docker sandboxes)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -mod=vendor \
    -trimpath \
    -ldflags="-s -w -X main.Version=${VERSION}" \
    -o /out/mcp-runner \
    ./cmd/mcp-runner

# Build the CLI tool (for `khepra_watch` daemon and manifest-gen)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -mod=vendor \
    -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/adinkhepra \
    ./cmd/adinkhepra

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
# Alpine chosen over Distroless for:
#  - apk shell access for STIG scan volume mounts (shell = /bin/sh)
#  - smaller than UBI-minimal for community image (Iron Bank = Dockerfile.ironbank)
FROM alpine:3.21

# Security hardening layer
RUN apk add --no-cache ca-certificates tzdata \
 && addgroup -g 10001 -S khepra \
 && adduser  -u 10001 -S -G khepra -h /var/lib/khepra -s /sbin/nologin khepra \
 && mkdir -p \
      /var/lib/khepra \
      /var/log/khepra \
      /etc/khepra \
      /app \
 && chown -R 10001:10001 \
      /var/lib/khepra \
      /var/log/khepra \
      /etc/khepra \
      /app \
 # Remove SUID/SGID bits (STIG V-230244 / CIS 6.3.1)
 && find / -xdev \( -perm -4000 -o -perm -2000 \) -type f -exec chmod a-s {} \; 2>/dev/null || true

# Copy binaries from builder
COPY --from=builder --chown=10001:10001 /out/khepra-mcp   /usr/local/bin/khepra-mcp
COPY --from=builder --chown=10001:10001 /out/mcp-runner    /app/mcp-runner
COPY --from=builder --chown=10001:10001 /out/adinkhepra    /usr/local/bin/adinkhepra

# Bake signed manifest into image (bootstrap — overridable via volume mount)
COPY --chown=10001:10001 manifest.json /app/manifest.json

# Bake public NIST/CCI mapping tables (zero-network, air-gap safe)
COPY --chown=10001:10001 docs/CCI_to_NIST53.csv    /app/docs/CCI_to_NIST53.csv
COPY --chown=10001:10001 docs/NIST53_to_171.csv    /app/docs/NIST53_to_171.csv
COPY --chown=10001:10001 docs/NIST53_to_172.csv    /app/docs/NIST53_to_172.csv

# ── Environment (all overridable at runtime) ──────────────────────────────────
ENV KHEPRA_MANIFEST_PATH=/app/manifest.json \
    PHANTOM_SYMBOL=Eban \
    PHANTOM_IMAGE=khepra-phantom:latest \
    # Audit log — mount /var/log/khepra as a volume for persistence
    KHEPRA_AUDIT_LOG_PATH=/var/log/khepra/audit.ndjson \
    # Concurrency: max parallel tool calls per agent (NSA prompt-storm defense)
    KHEPRA_MAX_CONCURRENT=5 \
    # License key — inject at runtime, never bake into image
    KHEPRA_LICENSE_KEY="" \
    # Tier: community | enterprise | govcloud
    KHEPRA_TIER=community \
    KHEPRA_HOME=/var/lib/khepra \
    KHEPRA_LOG_DIR=/var/log/khepra \
    KHEPRA_MCP_RUNNER_PATH=/app/mcp-runner

# OCI labels for MCP Registry + AWS Marketplace + Iron Bank
LABEL org.opencontainers.image.title="KHEPRA MCP Server" \
      org.opencontainers.image.description="Post-quantum MCP compliance server. Air-gappable. CMMC L2 + STIG + NIST 800-171. Signed tool responses. Zero token cost." \
      org.opencontainers.image.source="https://github.com/EtherVerseCodeMate/giza-cyber-shield" \
      org.opencontainers.image.licenses="Proprietary" \
      org.opencontainers.image.vendor="NouchiX SecRed Knowledge Inc." \
      # MCP Registry metadata (mcpservers.org / cline.bot)
      io.modelcontextprotocol.server.name="io.github.etherversecodemate/khepra-mcp" \
      io.modelcontextprotocol.server.transport="stdio" \
      io.modelcontextprotocol.server.tools="ert_scan,godfather_report,godfather_approve,nist_map,khepra_watch,acp_status,acp_issue,acp_revoke,nhi_inventory,nhi_orphans,nhi_excessive,nhi_expired,nhi_revoke" \
      # AWS Marketplace / Iron Bank
      com.nouchix.product="KHEPRA Protocol" \
      com.nouchix.tier="community" \
      io.openshift.tags="security,compliance,cmmc,post-quantum,mcp,zero-trust,stig,nist,air-gap"

WORKDIR /var/lib/khepra

# Non-root (OpenShift / Iron Bank requirement)
USER 10001

# MCP stdio transport: agent launches this binary as a subprocess
# stdout = JSON-RPC only, stderr = diagnostic logs
ENTRYPOINT ["/usr/local/bin/khepra-mcp"]
