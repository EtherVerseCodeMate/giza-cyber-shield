# syntax=docker/dockerfile:1
# Khepra Phantom Network Node — Air-gap safe, non-root, vendor-pinned build.
# No network calls at build time. No curl. No root runtime.

# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM golang:1.22-alpine AS builder

RUN apk add --no-cache git gcc musl-dev

WORKDIR /src

ARG VERSION=1.0.0

COPY go.mod go.sum ./
COPY vendor/ ./vendor/
COPY pkg/ ./pkg/
COPY cmd/ ./cmd/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -mod=vendor \
    -trimpath \
    -ldflags="-w -s -X main.Version=${VERSION}" \
    -o /out/phantom-node \
    ./cmd/phantom-node/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -mod=vendor \
    -trimpath \
    -ldflags="-w -s -X main.Version=${VERSION}" \
    -o /out/mcp-runner \
    ./cmd/mcp-runner/

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM alpine:3.21

RUN apk --no-cache add ca-certificates tzdata \
 && addgroup -g 1001 -S phantom \
 && adduser  -u 1001 -S -G phantom -h /var/lib/phantom -s /sbin/nologin phantom \
 && mkdir -p \
      /var/lib/phantom/keys \
      /var/lib/phantom/data/lattice \
      /app \
 && chown -R phantom:phantom /var/lib/phantom /app \
 # Remove SUID/SGID bits (STIG V-230244)
 && find / -xdev \( -perm -4000 -o -perm -2000 \) -type f -exec chmod a-s {} \; 2>/dev/null || true

COPY --from=builder --chown=phantom:phantom /out/phantom-node /app/phantom-node
COPY --from=builder --chown=phantom:phantom /out/mcp-runner   /app/mcp-runner

ENV KHEPRA_HOME=/var/lib/phantom

LABEL maintainer="NouchiX SecRed Knowledge Inc." \
      description="Khepra Phantom Network Node — PQC lattice signatures, Merkaba white-box encryption, spectral fingerprint" \
      security.non-root="true" \
      security.readonly-rootfs="compatible"

EXPOSE 8080 9090

# Health check via wget (busybox built-in — no curl needed)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/health || exit 1

USER phantom

ENTRYPOINT ["/app/phantom-node"]
